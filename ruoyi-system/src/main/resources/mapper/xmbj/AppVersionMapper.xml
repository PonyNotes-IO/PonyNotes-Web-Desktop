<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.xmbj.mapper.XmAppVersionMapper">

    <resultMap type="com.ruoyi.xmbj.domain.XmAppVersion" id="AppVersionResult">
        <result property="id" column="id"/>
        <result property="versionName" column="version_name"/>
        <result property="systemType" column="system_type"/>
        <result property="versionCode" column="version_code"/>
        <result property="updateDesc" column="update_desc"/>
        <result property="downloadUrl" column="download_url"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="operator" column="operator"/>
        <result property="operatorId" column="operator_id"/>
    </resultMap>

    <sql id="selectAppVersionVo">
        select id, version_name, system_type, version_code, update_desc, download_url, status, create_time, update_time, operator, operator_id from auth.app_version
    </sql>

    <select id="selectAppVersionList" parameterType="com.ruoyi.xmbj.domain.XmAppVersion" resultMap="AppVersionResult">
        <include refid="selectAppVersionVo"/>
        <where>
            <if test="versionName != null and versionName != ''">and version_name like concat('%', #{versionName}, '%')</if>
            <if test="systemType != null and systemType != ''">and system_type = #{systemType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
    </select>

    <select id="selectAppVersionById" parameterType="Long" resultMap="AppVersionResult">
        <include refid="selectAppVersionVo"/>
        where id = #{id}
    </select>

    <insert id="insertAppVersion" parameterType="com.ruoyi.xmbj.domain.XmAppVersion" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into auth.app_version
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="versionName != null">version_name,</if>
            <if test="systemType != null">system_type,</if>
            <if test="versionCode != null">version_code,</if>
            <if test="updateDesc != null">update_desc,</if>
            <if test="downloadUrl != null">download_url,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="operator != null">operator,</if>
            <if test="operatorId != null">operator_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="versionName != null">#{versionName},</if>
            <if test="systemType != null">#{systemType},</if>
            <if test="versionCode != null">#{versionCode},</if>
            <if test="updateDesc != null">#{updateDesc},</if>
            <if test="downloadUrl != null">#{downloadUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="operator != null">#{operator},</if>
            <if test="operatorId != null">#{operatorId},</if>
        </trim>
    </insert>

    <update id="updateAppVersion" parameterType="com.ruoyi.xmbj.domain.XmAppVersion">
        update auth.app_version
        <trim prefix="SET" suffixOverrides=",">
            <if test="versionName != null">version_name = #{versionName},</if>
            <if test="systemType != null">system_type = #{systemType},</if>
            <if test="versionCode != null">version_code = #{versionCode},</if>
            <if test="updateDesc != null">update_desc = #{updateDesc},</if>
            <if test="downloadUrl != null">download_url = #{downloadUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppVersionById" parameterType="Long">
        delete from auth.app_version where id = #{id}
    </delete>

    <delete id="deleteAppVersionByIds" parameterType="String">
        delete from auth.app_version where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查询所有活跃的应用版本 -->
    <select id="selectActiveAppVersions" resultMap="AppVersionResult">
        SELECT * FROM auth.app_version
        WHERE status = '正常'
        ORDER BY create_time DESC
    </select>

</mapper>
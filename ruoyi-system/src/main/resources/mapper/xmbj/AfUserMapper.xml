<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.xmbj.mapper.AfUserMapper">

    <resultMap type="com.ruoyi.xmbj.domain.AfUser" id="AfUserResult">
        <result property="uid"    column="uid"    />
        <result property="uuid"    column="uuid"    />
        <result property="email"    column="email"    />
        <result property="password"    column="password"    />
        <result property="name"    column="name"    />
        <result property="metadata"    column="metadata"    />
        <result property="encryptionSign"    column="encryption_sign"    />
        <result property="deletedAt"    column="deleted_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="createdAt"    column="created_at"    />
    </resultMap>

    <sql id="selectAfUserVo">
        select uid, uuid, email, password, name, metadata, encryption_sign, deleted_at, updated_at, created_at from af_user
    </sql>

    <select id="selectAfUserList" parameterType="AfUser" resultMap="AfUserResult">
        <include refid="selectAfUserVo"/>
        <where>
            <if test="uid != null "> and uid = #{uid}</if>
            <if test="uuid != null  and uuid != ''"> and uuid = #{uuid}</if>
            <if test="email != null  and email != ''"> and email like concat('%', #{email}, '%')</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="deletedAt != null "> and deleted_at = #{deletedAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
        </where>
    </select>

</mapper>
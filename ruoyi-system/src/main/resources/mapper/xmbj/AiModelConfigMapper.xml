<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.xmbj.mapper.AiModelConfigMapper">

    <resultMap type="AiModelConfig" id="AiModelConfigResult">
        <id     property="id"        column="id"       />
        <result property="modelName" column="model_name" />
        <result property="version"   column="version"   />
        <result property="apiKey"    column="api_key"   />
        <result property="apiUrl"    column="api_url"   />
        <result property="status"    column="status"    />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="operator"  column="operator"  />
        <result property="operatorId" column="operator_id" />
    </resultMap>

    <sql id="selectAiModelConfigVo">
        select id, model_name, version, api_key, api_url, status, create_time, update_time, operator, operator_id
        from auth.ai_model_config
    </sql>

    <select id="selectAiModelConfigList" parameterType="AiModelConfig" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        <where>
            <if test="modelName != null  and modelName != ''"> and model_name like concat('%', #{modelName}, '%')</if>
            <if test="version != null  and version != ''"> and version = #{version}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectAiModelConfigById" parameterType="Long" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where id = #{id}
    </select>

    <select id="selectActiveAiModelConfigs" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where status = '正常'
    </select>

    <insert id="insertAiModelConfig" parameterType="AiModelConfig" useGeneratedKeys="true" keyProperty="id">
        insert into auth.ai_model_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelName != null">model_name,</if>
            <if test="version != null">version,</if>
            <if test="apiKey != null">api_key,</if>
            <if test="apiUrl != null">api_url,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="operator != null">operator,</if>
            <if test="operatorId != null">operator_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="modelName != null">#{modelName},</if>
            <if test="version != null">#{version},</if>
            <if test="apiKey != null">#{apiKey},</if>
            <if test="apiUrl != null">#{apiUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="operator != null">#{operator},</if>
            <if test="operatorId != null">#{operatorId},</if>
        </trim>
    </insert>

    <update id="updateAiModelConfig" parameterType="AiModelConfig">
        update auth.ai_model_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="version != null">version = #{version},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="apiUrl != null">api_url = #{apiUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAiModelConfigByIds" parameterType="Long">
        delete from auth.ai_model_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="enableAiModelConfig" parameterType="Long">
        update auth.ai_model_config set status = '正常' where id = #{id}
    </update>

    <update id="disableAiModelConfig" parameterType="Long">
        update auth.ai_model_config set status = '停用' where id = #{id}
    </update>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysPaymentOrderMapper">
    <resultMap type="PaymentOrder" id="PaymentOrderResult">
        <id     property="id"               column="id"         />
        <result property="orderNo"          column="order_no"         />
        <result property="amount"           column="amount"       />
        <result property="paymentType"      column="payment_type"       />
        <result property="qrCodeUrl"        column="qr_code_url"           />
        <result property="phonenumber"      column="phonenumber"     />
        <result property="createTime"       column="create_time"             />
        <result property="updateTime"       column="update_time"          />
        <result property="payTime"          column="pay_time"        />
        <result property="status"           column="status"        />
    </resultMap>
    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, order_no, amount, payment_type, qr_code_url, status,
        phonenumber, create_time, update_time, pay_time
    </sql>

    <!-- 新增支付订单 -->
    <insert id="insert" parameterType="PaymentOrder" useGeneratedKeys="true" keyProperty="id">
        insert into sys_payment_order (
        <if test="orderNo != null and orderNo != ''">order_no,</if>
        <if test="amount != null">amount,</if>
        <if test="paymentType != null and paymentType != ''">payment_type,</if>
        <if test="qrCodeUrl != null and qrCodeUrl != ''">qr_code_url,</if>
        <if test="phonenumber != null and phonenumber != ''">phonenumber,</if>
        <if test="status != null and status != ''">status,</if>
        <if test="createTime != null">create_time,</if>
        update_time
        ) values (
        <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
        <if test="amount != null">#{amount},</if>
        <if test="paymentType != null and paymentType != ''">#{paymentType},</if>
        <if test="qrCodeUrl != null and qrCodeUrl != ''">#{qrCodeUrl},</if>
        <if test="phonenumber != null and phonenumber != ''">#{phonenumber},</if>
        <if test="status != null and status != ''">#{status},</if>
        <if test="createTime != null">#{createTime},</if>
        sysdate()
        )
    </insert>

    <!-- 根据订单号查询支付订单 -->
    <select id="selectOne" parameterType="String" resultMap="PaymentOrderResult">
        select
        <include refid="Base_Column_List"/>
        from sys_payment_order
        where order_no = #{orderNo}
    </select>

    <!-- 根据ID更新支付订单 -->
    <update id="updateById" parameterType="PaymentOrder">
        update sys_payment_order
        <set>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="paymentType != null and paymentType != ''">payment_type = #{paymentType},</if>
            <if test="qrCodeUrl != null and qrCodeUrl != ''">qr_code_url = #{qrCodeUrl},</if>
            <if test="phonenumber != null and phonenumber != ''">phonenumber = #{phonenumber},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>
    <select id="selectExpiredOrders"  resultMap="PaymentOrderResult">
        select
        <include refid="Base_Column_List"/>
        from sys_payment_order
        where status  = 'pending' and
        pay_time  &lt;= #{payTime}
    </select>
</mapper>

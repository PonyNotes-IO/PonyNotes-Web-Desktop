<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PaymentOrderMapper">

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, order_no, amount, payment_type, qr_code_url, status, 
        create_time, update_time, pay_time
    </sql>

    <!-- 根据订单号查询 -->
    <select id="selectByOrderNo" resultType="com.ruoyi.system.domain.PaymentOrder">
        select 
        <include refid="Base_Column_List" />
        from sys_payment_order 
        where order_no = #{orderNo}
    </select>

    <!-- 更新支付状态 -->
    <update id="updatePaymentStatus">
        update sys_payment_order 
        set status = #{status}, 
            pay_time = #{payTime}, 
            update_time = #{updateTime} 
        where order_no = #{orderNo}
    </update>

</mapper>
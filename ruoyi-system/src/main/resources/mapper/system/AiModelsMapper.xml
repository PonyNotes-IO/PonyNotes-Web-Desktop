<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiModelsMapper">
    
    <resultMap type="AiModels" id="AiModelsResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="version"    column="version"    />
        <result property="apiKey"    column="api_key"    />
        <result property="apiUrl"    column="api_url"    />
        <result property="status"    column="status"    />
        <result property="createdAt"    column="created_at"    />
        <result property="operator"    column="operator"    />
        <result property="operatorName"    column="operator_name"    />
    </resultMap>

    <sql id="selectAiModelsVo">
        select a.id, a.name, a.version, a.api_key, a.api_url, a.status, a.created_at, a.operator, u.user_name as operator_name
        from ai_models a
        left join sys_user u on a.operator = u.user_id
    </sql>

    <select id="selectAiModelsList" parameterType="AiModels" resultMap="AiModelsResult">
        <include refid="selectAiModelsVo"/>
        <where>  
            <if test="name != null  and name != ''"> and a.name like concat('%', #{name}, '%')</if>
            <if test="status != null"> and a.status = #{status}</if>
            <if test="operator != null  and operator != ''"> and a.operator = #{operator}</if>
        </where>
    </select>
    
    <select id="selectAiModelsById" parameterType="Long" resultMap="AiModelsResult">
        <include refid="selectAiModelsVo"/>
        where id = #{id}
    </select>

    <insert id="insertAiModels" parameterType="AiModels" useGeneratedKeys="true" keyProperty="id">
        insert into ai_models
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="version != null and version != ''">version,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="apiUrl != null and apiUrl != ''">api_url,</if>
            <if test="status != null">status,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="operator != null and operator != ''">operator,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="version != null and version != ''">#{version},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="apiUrl != null and apiUrl != ''">#{apiUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="operator != null and operator != ''">#{operator},</if>
         </trim>
    </insert>

    <update id="updateAiModels" parameterType="AiModels">
        update ai_models
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="apiUrl != null and apiUrl != ''">api_url = #{apiUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="operator != null and operator != ''">operator = #{operator},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAiModelsById" parameterType="Long">
        delete from ai_models where id = #{id}
    </delete>

    <delete id="deleteAiModelsByIds" parameterType="String">
        delete from ai_models where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysUserLoginRecordMapper">
    
    <resultMap type="SysUserLoginRecord" id="SysUserLoginRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="profileId"    column="profile_id"    />
        <result property="loginTime"    column="login_time"    />
        <result property="loginLocation"    column="login_location"    />
        <result property="loginIp"    column="login_ip"    />
        <result property="loginMethod"    column="login_method"    />
    </resultMap>

    <sql id="selectSysUserLoginRecordVo">
        select record_id, profile_id, login_time, login_location, login_ip, login_method from sys_user_login_record
    </sql>

    <select id="selectSysUserLoginRecordList" parameterType="SysUserLoginRecord" resultMap="SysUserLoginRecordResult">
        <include refid="selectSysUserLoginRecordVo"/>
        <where>  
            <if test="profileId != null "> and profile_id = #{profileId}</if>
            <if test="loginTime != null "> and login_time = #{loginTime}</if>
            <if test="loginLocation != null  and loginLocation != ''"> and login_location = #{loginLocation}</if>
            <if test="loginIp != null  and loginIp != ''"> and login_ip = #{loginIp}</if>
            <if test="loginMethod != null  and loginMethod != ''"> and login_method = #{loginMethod}</if>
        </where>
    </select>
    
    <select id="selectSysUserLoginRecordByRecordId" parameterType="Long" resultMap="SysUserLoginRecordResult">
        <include refid="selectSysUserLoginRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertSysUserLoginRecord" parameterType="SysUserLoginRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into sys_user_login_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="profileId != null">profile_id,</if>
            <if test="loginTime != null">login_time,</if>
            <if test="loginLocation != null">login_location,</if>
            <if test="loginIp != null">login_ip,</if>
            <if test="loginMethod != null">login_method,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="profileId != null">#{profileId},</if>
            <if test="loginTime != null">#{loginTime},</if>
            <if test="loginLocation != null">#{loginLocation},</if>
            <if test="loginIp != null">#{loginIp},</if>
            <if test="loginMethod != null">#{loginMethod},</if>
         </trim>
    </insert>

    <update id="updateSysUserLoginRecord" parameterType="SysUserLoginRecord">
        update sys_user_login_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="profileId != null">profile_id = #{profileId},</if>
            <if test="loginTime != null">login_time = #{loginTime},</if>
            <if test="loginLocation != null">login_location = #{loginLocation},</if>
            <if test="loginIp != null">login_ip = #{loginIp},</if>
            <if test="loginMethod != null">login_method = #{loginMethod},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteSysUserLoginRecordByRecordId" parameterType="Long">
        delete from sys_user_login_record where record_id = #{recordId}
    </delete>

    <delete id="deleteSysUserLoginRecordByRecordIds" parameterType="String">
        delete from sys_user_login_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
</mapper>
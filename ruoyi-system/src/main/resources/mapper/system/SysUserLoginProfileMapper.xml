<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysUserLoginProfileMapper">
    
    <resultMap type="SysUserLoginProfile" id="SysUserLoginProfileResult">
        <result property="profileId"    column="profile_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userSource"    column="user_source"    />
        <result property="userUniqueId"    column="user_unique_id"    />
        <result property="phone"    column="phone"    />
        <result property="loginTotalCount"    column="login_total_count"    />
        <result property="loginTotalDuration"    column="login_total_duration"    />
        <result property="registerTime"    column="register_time"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectSysUserLoginProfileVo">
        select profile_id, user_id, user_source, user_unique_id, phone, login_total_count, login_total_duration, register_time, create_time from sys_user_login_profile
    </sql>

    <select id="selectSysUserLoginProfileList" parameterType="SysUserLoginProfile" resultMap="SysUserLoginProfileResult">
        <include refid="selectSysUserLoginProfileVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userSource != null  and userSource != ''"> and user_source = #{userSource}</if>
            <if test="userUniqueId != null  and userUniqueId != ''"> and user_unique_id = #{userUniqueId}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="loginTotalCount != null "> and login_total_count = #{loginTotalCount}</if>
            <if test="loginTotalDuration != null  and loginTotalDuration != ''"> and login_total_duration = #{loginTotalDuration}</if>
            <if test="registerTime != null "> and register_time = #{registerTime}</if>
        </where>
    </select>
    
    <select id="selectSysUserLoginProfileByProfileId" parameterType="Long" resultMap="SysUserLoginProfileResult">
        <include refid="selectSysUserLoginProfileVo"/>
        where profile_id = #{profileId}
    </select>

    <insert id="insertSysUserLoginProfile" parameterType="SysUserLoginProfile" useGeneratedKeys="true" keyProperty="profileId">
        insert into sys_user_login_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userSource != null and userSource != ''">user_source,</if>
            <if test="userUniqueId != null and userUniqueId != ''">user_unique_id,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="loginTotalCount != null">login_total_count,</if>
            <if test="loginTotalDuration != null and loginTotalDuration != ''">login_total_duration,</if>
            <if test="registerTime != null">register_time,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userSource != null and userSource != ''">#{userSource},</if>
            <if test="userUniqueId != null and userUniqueId != ''">#{userUniqueId},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="loginTotalCount != null">#{loginTotalCount},</if>
            <if test="loginTotalDuration != null and loginTotalDuration != ''">#{loginTotalDuration},</if>
            <if test="registerTime != null">#{registerTime},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateSysUserLoginProfile" parameterType="SysUserLoginProfile">
        update sys_user_login_profile
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userSource != null and userSource != ''">user_source = #{userSource},</if>
            <if test="userUniqueId != null and userUniqueId != ''">user_unique_id = #{userUniqueId},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="loginTotalCount != null">login_total_count = #{loginTotalCount},</if>
            <if test="loginTotalDuration != null and loginTotalDuration != ''">login_total_duration = #{loginTotalDuration},</if>
            <if test="registerTime != null">register_time = #{registerTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where profile_id = #{profileId}
    </update>

    <delete id="deleteSysUserLoginProfileByProfileId" parameterType="Long">
        delete from sys_user_login_profile where profile_id = #{profileId}
    </delete>

    <delete id="deleteSysUserLoginProfileByProfileIds" parameterType="String">
        delete from sys_user_login_profile where profile_id in 
        <foreach item="profileId" collection="array" open="(" separator="," close=")">
            #{profileId}
        </foreach>
    </delete>
</mapper>